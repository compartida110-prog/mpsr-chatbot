# Entorno
venv/
__pycache__/
*.pyc
.env

# Rasa
.rasa/
*.tar.gz

# Modelos (pesados; no versionar directamente, usar Git LFS si es necesario)
models/*
!models/.gitkeep

# Los resultados de logs/ SÍ se versionan (P15: predicciones, métricas, configs);
# solo se excluyen los logs crudos de entrenamiento.
logs/**/train.log

# Sistema
.DS_Store
logs/rasa_phase2_full.txt
logs/*.bak
logs/**/train_fold*.log

# Lote 1 real: el seguimiento lleno (ocupación, residencia) y los consentimientos NO se versionan
docs/lote_real_1/privado/*
!docs/lote_real_1/privado/LEEME.md
corpus/real/consentimientos/
Seguimiento_Lote1_Participantes_real*.xlsx
~$*.xlsx

# Piloto exploratorio V1.3: el registro real lleno y las hojas originales NO se versionan
docs/piloto/privado/*
!docs/piloto/privado/LEEME.md

# Lote 1 REAL: frases reales y derivados de la ingesta (no subir; revisar datos personales primero)
corpus/real/lote1_*.csv
logs/v3_real/ingesta_reporte.txt
logs/v3_real/revision_reporte.txt

# Partición v3 con frases REALES (validación y test): no subir
corpus/v3_real/*
!corpus/v3_real/.gitkeep
data/v3/nlu_train.yml
data/v3/nlu_validation.yml
data/v3/nlu_test.yml
logs/v3_real/*
!logs/v3_real/.gitkeep
!logs/v3_real/auditoria_*.md

# Lote 2 REAL (prueba independiente de G3): frases, libros llenos y derivados de la ingesta. NO subir.
docs/lote_real_2/privado/*
!docs/lote_real_2/privado/LEEME.md
corpus/real_lote2/*
!corpus/real_lote2/.gitkeep
corpus/v3_lote2/*
!corpus/v3_lote2/.gitkeep
data/v3_lote2/nlu_*.yml

# Carpetas de entrenamiento de la validación cruzada por participante (config y log; los resultados van en logs/avance y logs/v3_real)
logs/CVP-RASA-fold*/

# Congelamiento previo al lote 2: solo huellas y rutas (sin frases); se versiona para que quede constancia anterior a los datos del lote 2
!logs/v3_real/lote2_congelado_previo.json
!logs/v3_real/lote2_umbral_congelado.json
!logs/v3_real/lote2_congelado_previo_svm.json
!logs/v3_real/lote2_congelado_previo_2*.json
!logs/v3_real/modelo_congelado.json

# Paquetes de Colab (contienen material derivado de datos reales: no versionar los .zip ni el trabajo intermedio)
colab_paquetes/*.zip
colab_paquetes/_trabajo/
colab_paquetes/_cache/
colab_paquetes/colab_por_paso/
